{
  "info": {
    "_postman_id": "6f1c45ce-1d6c-4d54-85dd-1c4c0d67a005",
    "name": "Spring Boot Rescue Lab",
    "description": "Runnable local requests for the completed rescue lab. Create a product first, then create/list/read orders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "adminPassword", "value": "admin-change-me"},
    {"key": "alicePassword", "value": "alice-change-me"},
    {"key": "productId", "value": ""},
    {"key": "orderId", "value": ""}
  ],
  "item": [
    {
      "name": "Operations",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"]}
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/actuator/health/readiness", "host": ["{{baseUrl}}"], "path": ["actuator", "health", "readiness"]}
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('productId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {"key": "username", "value": "admin", "type": "string"},
                {"key": "password", "value": "{{adminPassword}}", "type": "string"}
              ]
            },
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"POSTMAN-KEYBOARD-01\",\n  \"name\": \"Postman Keyboard\",\n  \"unitPrice\": 80.00,\n  \"availableStock\": 10\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/admin/products", "host": ["{{baseUrl}}"], "path": ["api", "admin", "products"]}
          }
        },
        {
          "name": "Prometheus metrics",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {"key": "username", "value": "admin", "type": "string"},
                {"key": "password", "value": "{{adminPassword}}", "type": "string"}
              ]
            },
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/actuator/prometheus", "host": ["{{baseUrl}}"], "path": ["actuator", "prometheus"]}
          }
        }
      ]
    },
    {
      "name": "Alice orders",
      "item": [
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('orderId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {"key": "username", "value": "alice", "type": "string"},
                {"key": "password", "value": "{{alicePassword}}", "type": "string"}
              ]
            },
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Idempotency-Key", "value": "postman-checkout-001"},
              {"key": "X-Correlation-Id", "value": "postman-demo-001"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"]}
          }
        },
        {
          "name": "List my orders",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {"key": "username", "value": "alice", "type": "string"},
                {"key": "password", "value": "{{alicePassword}}", "type": "string"}
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [{"key": "page", "value": "0"}, {"key": "size", "value": "20"}]
            }
          }
        },
        {
          "name": "Read order",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {"key": "username", "value": "alice", "type": "string"},
                {"key": "password", "value": "{{alicePassword}}", "type": "string"}
              ]
            },
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"]}
          }
        }
      ]
    }
  ]
}
