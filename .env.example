POSTGRES_DB=rescue_lab
POSTGRES_USER=rescue_lab
POSTGRES_PASSWORD=rescue_lab
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/rescue_lab
DB_USERNAME=rescue_lab
DB_PASSWORD=rescue_lab
RABBITMQ_HOST=localhost
RABBITMQ_USER=rescue_lab
RABBITMQ_PASSWORD=rescue_lab
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_HOST=localhost
REDIS_PORT=6379
APP_PORT=8080
ALICE_PASSWORD=alice-change-me
BOB_PASSWORD=bob-change-me
ADMIN_PASSWORD=admin-change-me

# Reliable event delivery
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_BATCH_SIZE=25
OUTBOX_INITIAL_DELAY=PT5S
OUTBOX_INTERVAL=PT2S
OUTBOX_RETRY_BASE=PT2S
OUTBOX_RETRY_MAX=PT5M
ORDER_EVENTS_CONSUMER_ENABLED=true
ORDER_EVENTS_CONFIRM_TIMEOUT=PT5S

# Observability
LOG_FORMAT=ecs
